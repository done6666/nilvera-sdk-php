{
    "name": "done6666/nilvera-sdk-php",
    "description": "Official PHP SDK for the Nilvera e-document API (e-Invoice, e-Archive, e-Waybill and more)",
    "type": "library",
    "keywords": ["nilvera", "e-fatura", "e-invoice", "e-archive", "e-arsiv", "turkey", "sdk"],
    "homepage": "https://developer.nilvera.com",
    "license": "MIT",
    "authors": [
        {
            "name": "done6666",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.5",
        "guzzlehttp/psr7": "^2.5",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "friendsofphp/php-cs-fixer": "^3.40"
    },
    "autoload": {
        "psr-4": {
            "Nilvera\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nilvera\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
